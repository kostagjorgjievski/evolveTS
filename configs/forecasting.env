# Claude CLI agent settings for gift_forecasting under the DREAM-RSI paper protocol.
# Run sizes (rounds, grid, workers, learning) are the upstream launch-script
# defaults; set ROUNDS, BRANCHES, REFINE, MAX_WORKERS etc. only to deviate.
export AGENT=claude
export DRSI_CLAUDE_CLI="${DRSI_CLAUDE_CLI:-$(command -v claude || true)}"
export DRSI_CLAUDE_PERMISSION_MODE=bypassPermissions
export ENABLE_TOOL_SEARCH=false
# The paper's agent time limit for non-kernel tasks (GEMINI_TIMEOUT_SEC=12000).
export CLAUDE_EXEC_TIMEOUT_SEC=12000
export API_TIMEOUT_MS=1200000
# The GLM account throttles above about ten concurrent requests (429 [1302]).
export CLAUDE_CODE_MAX_RETRIES=3
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
export CLAUDE_CODE_MAX_OUTPUT_TOKENS=32768
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=5000
export CLAUDE_CODE_DISABLE_BACKGROUND_TASKS=1
# The paper's agents carry nothing between sessions except the branch history
# upstream provides; the CLI's per-directory auto memory would add a side channel.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1
export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export PYTHONHASHSEED=0
# Branches link earlier rounds instead of copying them (upstream option; the
# paper copied). Copies exceed the /home inode quota within a few rounds.
export DRSI_HISTORY_SEED_MODE=symlink
export CUDA_VISIBLE_DEVICES=0
